{
  "name": "tenant-billing-webhooks",
  "version": "0.1.0",
  "private": true,
  "description": "Idempotent billing webhook handler + CDK stack for tenant document ingestion",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "cdk:synth": "cdk synth",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_billing.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
